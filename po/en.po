#: dynotiq.py:879 dynotiq.py:881 dynotiq.py:9255 dynotiq.py:9256
#: dynotiq.py:9259
#, python-brace-format
msgid "Build {id}"
msgstr "Build {id}"

#: dynotiq.py:880 dynotiq.py:9258
msgid "neu"
msgstr "new"

#: dynotiq.py:934
#, python-brace-format
msgid "Paketlisten sind {n} Tage alt"
msgstr "Package lists are {n} days old"

#: dynotiq.py:935
msgid "Paketlisten sind einen Tag alt"
msgstr "Package lists are a day old"

#: dynotiq.py:938
#, python-brace-format
msgid "Paketlisten sind {n} h alt"
msgstr "Package lists are {n} h old"

#: dynotiq.py:939
msgid "Paketlisten frisch geholt"
msgstr "Package lists just fetched"

#: dynotiq.py:956
#, python-brace-format
msgid "{tool} antwortet nicht"
msgstr "{tool} is not responding"

#: dynotiq.py:960
#, python-brace-format
msgid "{tool} endete mit Code {rc}"
msgstr "{tool} exited with code {rc}"

#: dynotiq.py:988
msgid "fwupdmgr nicht erreichbar"
msgstr "fwupdmgr not reachable"

#: dynotiq.py:1192
msgid "Paket"
msgstr "Package"

#: dynotiq.py:1193
msgid "manuell installiert"
msgstr "installed by hand"

#: dynotiq.py:1194
msgid "Steam-Titel"
msgstr "Steam title"

#: dynotiq.py:1199 dynotiq.py:9788
msgid "Mikrofon"
msgstr "Microphone"

#: dynotiq.py:1199
msgid "Die App kann nichts aufnehmen. Nötig für Spracheingabe oder Anrufe."
msgstr "The app cannot record. Needed for voice input or calls."

#: dynotiq.py:1201
msgid "Tonwiedergabe"
msgstr "Audio playback"

#: dynotiq.py:1201
msgid "Die App bleibt stumm."
msgstr "The app stays silent."

#: dynotiq.py:1202
msgid "Kamera"
msgstr "Camera"

#: dynotiq.py:1202
msgid "Video und Fotos gehen nicht."
msgstr "Video and photos will not work."

#: dynotiq.py:1203 dynotiq.py:9789
msgid "USB-Sticks und externe Laufwerke"
msgstr "USB sticks and external drives"

#: dynotiq.py:1203
msgid "Die App sieht nur dein Home-Verzeichnis, nichts unter /media."
msgstr "The app only sees your home directory, nothing under /media."

#: dynotiq.py:1205
msgid "Eigene Dateien"
msgstr "Your files"

#: dynotiq.py:1205
msgid "Die App kommt nicht an dein Home-Verzeichnis."
msgstr "The app cannot reach your home directory."

#: dynotiq.py:1206
msgid "Internet"
msgstr "Internet"

#: dynotiq.py:1206
msgid "Die App kann nicht ins Netz."
msgstr "The app cannot go online."

#: dynotiq.py:1207
msgid "Netzwerkeinstellungen"
msgstr "Network settings"

#: dynotiq.py:1207
msgid "Nur nötig, wenn die App Verbindungen selbst einrichten soll."
msgstr "Only needed if the app is meant to set up connections itself."

#: dynotiq.py:1209
msgid "Drucken"
msgstr "Printing"

#: dynotiq.py:1209
msgid "Druckaufträge gehen nicht raus."
msgstr "Print jobs will not go out."

#: dynotiq.py:1210 dynotiq.py:1211
msgid "Bluetooth"
msgstr "Bluetooth"

#: dynotiq.py:1210 dynotiq.py:1211
msgid "Geräte lassen sich nicht koppeln."
msgstr "Devices cannot be paired."

#: dynotiq.py:1212
msgid "Standort"
msgstr "Location"

#: dynotiq.py:1212
msgid "Ortsbezogene Funktionen bleiben leer."
msgstr "Location based features stay empty."

#: dynotiq.py:1213
msgid "Schlüsselbund"
msgstr "Keyring"

#: dynotiq.py:1213
msgid ""
"Gespeicherte Passwörter sind nicht erreichbar, Anmeldungen fragen jedes Mal "
"neu."
msgstr "Saved passwords are out of reach, every login asks again."

#: dynotiq.py:1215
msgid "Bildschirmschoner unterdrücken"
msgstr "Inhibit screensaver"

#: dynotiq.py:1215
msgid "Der Bildschirm schaltet auch während Wiedergabe oder Präsentation ab."
msgstr "The screen also switches off during playback or a presentation."

#: dynotiq.py:1217
msgid "Systemprozesse ansehen"
msgstr "View system processes"

#: dynotiq.py:1217
msgid "Nur für Werkzeuge nötig, die andere Programme überwachen."
msgstr "Only needed for tools that monitor other programs."

#: dynotiq.py:1219
msgid "Prozesse steuern"
msgstr "Control processes"

#: dynotiq.py:1219 dynotiq.py:1243
msgid "Nur für Systemwerkzeuge nötig."
msgstr "Only needed for system tools."

#: dynotiq.py:1220
msgid "Hardware auslesen"
msgstr "Read hardware"

#: dynotiq.py:1220
msgid "Angaben zu Geräten bleiben leer."
msgstr "Device details stay empty."

#: dynotiq.py:1221
msgid "Laufwerke sehen"
msgstr "See drives"

#: dynotiq.py:1222
msgid "Eingehängte Datenträger bleiben unsichtbar."
msgstr "Mounted volumes stay invisible."

#: dynotiq.py:1223
msgid "USB-Geräte direkt"
msgstr "Direct USB access"

#: dynotiq.py:1223
msgid "Nötig für Programmiergeräte, Scanner und Ähnliches."
msgstr "Needed for programmers, scanners and the like."

#: dynotiq.py:1225
msgid "CD- und DVD-Laufwerk"
msgstr "CD and DVD drive"

#: dynotiq.py:1225
msgid "Discs werden nicht gelesen."
msgstr "Discs will not be read."

#: dynotiq.py:1226
msgid "Gamecontroller"
msgstr "Game controller"

#: dynotiq.py:1226
msgid "Controller werden nicht erkannt."
msgstr "Controllers will not be detected."

#: dynotiq.py:1227
msgid "GPG-Schlüssel"
msgstr "GPG keys"

#: dynotiq.py:1227
msgid "Signieren und Entschlüsseln geht nicht."
msgstr "Signing and decrypting will not work."

#: dynotiq.py:1228
msgid "Firmenanmeldung"
msgstr "Enterprise login"

#: dynotiq.py:1229
msgid "Nur in Firmennetzen mit Kerberos nötig."
msgstr "Only needed on corporate networks with Kerberos."

#: dynotiq.py:1230
msgid "Geräte im lokalen Netz finden"
msgstr "Find devices on the local network"

#: dynotiq.py:1230
msgid "Drucker und Freigaben tauchen nicht von selbst auf."
msgstr "Printers and shares will not show up on their own."

#: dynotiq.py:1232
msgid "Chipkartenleser"
msgstr "Smart card reader"

#: dynotiq.py:1232
msgid "Signaturkarten werden nicht erkannt."
msgstr "Signature cards will not be detected."

#: dynotiq.py:1233
msgid "Sicherheitsschlüssel"
msgstr "Security keys"

#: dynotiq.py:1233
msgid "YubiKey und ähnliche Sticks werden nicht erkannt."
msgstr "YubiKey and similar sticks will not be detected."

#: dynotiq.py:1235
msgid "Andere Programme starten"
msgstr "Launch other programs"

#: dynotiq.py:1235
msgid "Links öffnen sich möglicherweise nicht im Browser."
msgstr "Links may not open in the browser."

#: dynotiq.py:1237
msgid "Bestimmte eigene Dateien"
msgstr "Specific files of yours"

#: dynotiq.py:1237
msgid "Zugriff auf einzelne Ordner im Home."
msgstr "Access to individual folders in home."

#: dynotiq.py:1239
msgid "Bestimmte Systemdateien"
msgstr "Specific system files"

#: dynotiq.py:1240
msgid "Zugriff auf einzelne Systemordner."
msgstr "Access to individual system folders."

#: dynotiq.py:1241
msgid "Gemeinsamer Speicher"
msgstr "Shared memory"

#: dynotiq.py:1241
msgid "Nötig für manche Fenster- und Videofunktionen."
msgstr "Needed for some window and video features."

#: dynotiq.py:1243
msgid "Rechnername ändern"
msgstr "Change hostname"

#: dynotiq.py:1244
msgid "TV-Karte"
msgstr "TV card"

#: dynotiq.py:1244
msgid "Fernsehempfang geht nicht."
msgstr "TV reception will not work."

#: dynotiq.py:1245
msgid "Eingabegeräte direkt"
msgstr "Direct input devices"

#: dynotiq.py:1245
msgid "Nötig für manche Tastatur- und Controllerfunktionen."
msgstr "Needed for some keyboard and controller features."

#: dynotiq.py:1256 dynotiq.py:9793
msgid "Was genau dahinter steckt, sagt die Beschreibung des Snaps."
msgstr "What exactly this covers is in the snap's own description."

#: dynotiq.py:1527
msgid "Shader-Cache ist abgeschaltet"
msgstr "Shader cache is switched off"

#: dynotiq.py:1528
msgid ""
"__GL_SHADER_DISK_CACHE steht in dieser Sitzung auf 0. Damit übersetzt der "
"Treiber bei jedem Spielstart alles neu, und jede Szene ruckelt beim ersten "
"Betreten wieder. Die Variable entfernen oder auf 1 setzen. Steht sie nur in "
"den Startoptionen eines einzelnen Spiels, gilt das auch nur dort."
msgstr ""
"__GL_SHADER_DISK_CACHE is set to 0 in this session. The driver recompiles "
"everything on every launch, so every scene stutters again the first time you "
"enter it. Remove the variable or set it to 1. If it is only set in the "
"launch options of a single game, it applies there and nowhere else."

#: dynotiq.py:1537
#, python-brace-format
msgid "{name}-Shader-Cache ist voll"
msgstr "{name} shader cache is full"

#: dynotiq.py:1538
#, python-brace-format
msgid ""
"{size} von {limit}. Ist die Grenze erreicht, wirft der Treiber alte Einträge "
"weg und übersetzt sie beim nächsten Mal neu. Das sind die Ruckler, die immer "
"an denselben Stellen wiederkommen. Abhilfe: __GL_SHADER_DISK_CACHE_SIZE "
"höher setzen, 10 GB sind für eine große Sammlung realistisch."
msgstr ""
"{size} of {limit}. Once the limit is reached the driver drops old entries "
"and recompiles them next time. Those are the stutters that keep coming back "
"at the same spots. Fix: raise __GL_SHADER_DISK_CACHE_SIZE, 10 GB is "
"realistic for a large library."

#: dynotiq.py:1546 dynotiq.py:1561
#, python-brace-format
msgid "{name}-Shader-Cache"
msgstr "{name} shader cache"

#: dynotiq.py:1547
#, python-brace-format
msgid "{size} von {limit}, {kind}."
msgstr "{size} of {limit}, {kind}."

#: dynotiq.py:1549
msgid "selbst gesetzt"
msgstr "set by you"

#: dynotiq.py:1550
msgid "Standardgrenze"
msgstr "default limit"

#: dynotiq.py:1552
msgid "Steam hat keine Shader vorbereitet"
msgstr "Steam has not prepared any shaders"

#: dynotiq.py:1553
#, python-brace-format
msgid ""
"Der Cache ist mit {size} praktisch leer, obwohl {n} Titel installiert sind. "
"Entweder steht in den Steam-Einstellungen unter Downloads die Shader-"
"Vorabverarbeitung auf aus, oder es lief noch kein Vulkan-Spiel. "
"Eingeschaltet übersetzt Steam die Shader beim Herunterladen statt mitten im "
"Spiel."
msgstr ""
"At {size} the cache is practically empty although {n} titles are installed. "
"Either shader pre-caching is off under Downloads in the Steam settings, or "
"no Vulkan title has run yet. Switched on, Steam compiles the shaders while "
"downloading instead of mid-game."

#: dynotiq.py:1562
#, python-brace-format
msgid ""
"{size} in {n} Bibliothek(en). Steam legt hier die vorab übersetzten Shader "
"ab, das spart genau die Ruckler beim ersten Spielstart."
msgstr ""
"{size} across {n} librarie(s). Steam stores the pre-compiled shaders here, "
"which is what saves you the stutters on the first launch."

#: dynotiq.py:1579
msgid "Kein Platz für den Shader-Cache"
msgstr "No room for the shader cache"

#: dynotiq.py:1580
#, python-brace-format
msgid ""
"Auf der Partition mit {path} sind nur noch {free} frei. Was nicht "
"geschrieben werden kann, wird bei jedem Start neu übersetzt."
msgstr ""
"Only {free} left on the partition holding {path}. Whatever cannot be written "
"is compiled again on every start."

#: dynotiq.py:1596
msgid "Nicht installiert"
msgstr "Not installed"

#: dynotiq.py:1597
#, python-brace-format
msgid ""
"Der Starter zeigt auf Steam-Titel {id}, in keiner Bibliothek liegt dazu eine "
"Installation. Der Menüeintrag bleibt auch nach dem Deinstallieren stehen."
msgstr ""
"The launcher points at Steam title {id}, but no library holds an "
"installation for it. The menu entry stays behind after uninstalling."

#: dynotiq.py:1601
#, python-brace-format
msgid "zuletzt gespielt am {date}"
msgstr "last played on {date}"

#: dynotiq.py:1603
msgid "noch nicht gespielt"
msgstr "not played yet"

#: dynotiq.py:1604
#, python-brace-format
msgid "Steam-Titel {id}"
msgstr "Steam title {id}"

#: dynotiq.py:1605
#, python-brace-format
msgid "{size} in {lib}, {played}."
msgstr "{size} in {lib}, {played}."

#: dynotiq.py:1610
msgid "Läuft über Proton"
msgstr "Runs through Proton"

#: dynotiq.py:1611
#, python-brace-format
msgid ""
"Eingestellt ist {p}. Das Spiel ist für Windows gebaut und wird übersetzt, "
"deshalb hängt die Bildrate auch an der Proton-Fassung."
msgstr ""
"Set to {p}. The game is built for Windows and gets translated, so the frame "
"rate also depends on the Proton build."

#: dynotiq.py:1613
msgid "die Voreinstellung"
msgstr "the default"

#: dynotiq.py:1614
#, python-brace-format
msgid " Der Prefix belegt {size}."
msgstr " The prefix takes up {size}."

#: dynotiq.py:1617
msgid "Nativer Linux-Titel"
msgstr "Native Linux title"

#: dynotiq.py:1618
msgid "Kein Proton-Prefix vorhanden, das Spiel läuft direkt."
msgstr "No Proton prefix present, the game runs directly."

#: dynotiq.py:1622
msgid "Shader-Cache dieses Spiels"
msgstr "Shader cache for this game"

#: dynotiq.py:1623
#, python-brace-format
msgid ""
"{size} liegen bereit. Was hier steht, muss der Treiber im Spiel nicht mehr "
"übersetzen, das sind die Ruckler, die du nicht bekommst."
msgstr ""
"{size} are ready. Whatever sits here the driver no longer has to compile in-"
"game, and those are the stutters you do not get."

#: dynotiq.py:1627
msgid "Kaum Shader vorbereitet"
msgstr "Hardly any shaders prepared"

#: dynotiq.py:1628
#, python-brace-format
msgid ""
"Für dieses Spiel liegen nur {size} im Cache. Beim ersten Betreten jeder "
"Szene übersetzt der Treiber dann neu, und genau das ruckelt. Steam holt die "
"Shader beim Herunterladen, wenn in den Einstellungen unter Downloads die "
"Shader-Vorabverarbeitung an ist."
msgstr ""
"Only {size} in the cache for this game. The driver then compiles on first "
"entry to every scene, and that is what stutters. Steam fetches the shaders "
"while downloading if shader pre-caching is on under Downloads in the "
"settings."

#: dynotiq.py:1637
msgid "Startoptionen gesetzt"
msgstr "Launch options set"

#: dynotiq.py:1638
#, python-brace-format
msgid "Vor dem Spiel läuft: {opts}"
msgstr "Runs before the game: {opts}"

#: dynotiq.py:1640
msgid "GameMode wird hier nicht genutzt"
msgstr "GameMode is not used here"

#: dynotiq.py:1641
msgid ""
"GameMode ist installiert, steht aber nicht in den Startoptionen dieses "
"Spiels. Mit 'gamemoderun %command%' hebt es für die Spieldauer den CPU-Takt "
"an und nimmt Hintergrunddienste zurück."
msgstr ""
"GameMode is installed but not listed in this game's launch options. With "
"'gamemoderun %command%' it raises the CPU clock for the duration of the game "
"and holds back background services."

#: dynotiq.py:1648
msgid "Wenig Platz auf dieser Platte"
msgstr "Little room on this drive"

#: dynotiq.py:1649
#, python-brace-format
msgid ""
"Nur noch {free} frei in {lib}. Shader-Cache und Zwischenstände wachsen im "
"Spiel weiter, und ein Update braucht kurzzeitig das Doppelte."
msgstr ""
"Only {free} left in {lib}. Shader cache and save data keep growing while you "
"play, and an update briefly needs twice its size."

#: dynotiq.py:1762
msgid "ntsync ist bereit"
msgstr "ntsync is ready"

#: dynotiq.py:1763
msgid ""
"Proton wickelt die Threads von Windows-Spielen über den Kernel ab. Das ist "
"der schnellste Weg und spart vor allem Mikroruckler."
msgstr ""
"Proton hands the threads of Windows games to the kernel. That is the fastest "
"route and above all it saves you micro stutter."

#: dynotiq.py:1767
msgid "Der Kernel kennt ntsync noch nicht"
msgstr "This kernel does not know ntsync yet"

#: dynotiq.py:1768
msgid ""
"Ab Linux 6.14 wickelt Proton die Threads von Windows-Spielen über den Kernel "
"ab, was Mikroruckler nimmt. Dieser Kernel kann das nicht, ein neuerer bringt "
"es mit."
msgstr ""
"From Linux 6.14 on, Proton hands the threads of Windows games to the kernel, "
"which takes away micro stutter. This kernel cannot do that, a newer one "
"brings it along."

#: dynotiq.py:1771
msgid "ntsync ist da, aber nicht geladen"
msgstr "ntsync is there but not loaded"

#: dynotiq.py:1772
msgid ""
"Der Kernel bringt das Modul mit, Ubuntu lädt es aber nie. Proton fällt "
"deshalb stillschweigend auf den älteren Weg zurück. Geladen laufen Windows-"
"Spiele runder, spürbar an den Mikrorucklern, nicht an der "
"Durchschnittsbildrate."
msgstr ""
"The kernel ships the module, but Ubuntu never loads it. Proton therefore "
"falls back to the older route without saying a word. Once it is loaded, "
"Windows games run smoother, and you notice it in the micro stutter rather "
"than in the average frame rate."

#: dynotiq.py:1776
msgid "Laden und dauerhaft eintragen"
msgstr "Load it and make it permanent"

#: dynotiq.py:1805
msgid "Resizable BAR ist an"
msgstr "Resizable BAR is on"

#: dynotiq.py:1806
#, python-brace-format
msgid ""
"Die CPU sieht die vollen {v} MB Grafikspeicher am Stück. So sollen Texturen "
"dorthin kommen."
msgstr ""
"The CPU sees all {v} MB of graphics memory in one piece. That is how "
"textures are meant to get there."

#: dynotiq.py:1808
msgid "Resizable BAR ist aus"
msgstr "Resizable BAR is off"

#: dynotiq.py:1809
#, python-brace-format
msgid ""
"Die CPU sieht nur ein Fenster von {v} MB auf den Grafikspeicher, möglich "
"wären {m} MB. Texturen gehen dann in kleinen Stücken hinüber. Einzustellen "
"ist das nur im UEFI des Mainboards, dort heißt es 'Re-Size BAR Support' und "
"verlangt zusätzlich 'Above 4G Decoding'."
msgstr ""
"The CPU only sees a {v} MB window onto the graphics memory, {m} MB would be "
"possible. Textures then cross over in small pieces. This can only be changed "
"in the mainboard UEFI, where it is called 'Re-Size BAR Support' and "
"additionally requires 'Above 4G Decoding'."

#: dynotiq.py:1824
msgid "GameMode ist nicht installiert"
msgstr "GameMode is not installed"

#: dynotiq.py:1825
msgid ""
"GameMode stellt für die Dauer des Spiels den CPU-Governor auf performance "
"und nimmt Hintergrunddienste zurück. Danach setzt es alles selbst wieder um. "
"Im Spiel als Startbefehl 'gamemoderun %command%' eintragen."
msgstr ""
"For the duration of the game GameMode sets the CPU governor to performance "
"and holds back background services. Afterwards it puts everything back "
"itself. Enter 'gamemoderun %command%' as the game's launch command."

#: dynotiq.py:1829
msgid "GameMode installieren"
msgstr "Install GameMode"

#: dynotiq.py:1835 dynotiq.py:3346
#, python-brace-format
msgid "CPU-Governor steht auf {gov}"
msgstr "CPU governor is set to {gov}"

#: dynotiq.py:1836
msgid ""
"Der Takt geht erst hoch, wenn die Last schon da ist. Beim Spielen kostet das "
"genau in den Momenten Bilder, in denen es ruckelt. GameMode stellt das je "
"Spiel um, dauerhaft geht es über den Befehl auf der Problemseite."
msgstr ""
"The clock only ramps up once the load is already there. While gaming that "
"costs frames in exactly the moments that stutter. GameMode switches it per "
"game, permanently it works through the command on the problems page."

#: dynotiq.py:1842
msgid "vm.max_map_count ist zu niedrig"
msgstr "vm.max_map_count is too low"

#: dynotiq.py:1843
#, python-brace-format
msgid ""
"Steht auf {v}. Moderne Titel unter Proton legen mehr Speicherbereiche an und "
"stürzen ab oder starten gar nicht erst. 1048576 ist der Wert, den SteamOS "
"setzt."
msgstr ""
"Set to {v}. Modern titles under Proton map more memory areas and either "
"crash or never start. 1048576 is the value SteamOS uses."

#: dynotiq.py:1846
msgid "Dauerhaft setzen"
msgstr "Set permanently"

#: dynotiq.py:1855
msgid "Zu wenige Dateizeiger erlaubt"
msgstr "Too few file handles allowed"

#: dynotiq.py:1856
#, python-brace-format
msgid ""
"Die Obergrenze liegt bei {v}. Proton legt für Threads eigene Dateizeiger an, "
"bei zu wenigen bricht das Spiel mit 'Too many open files' ab."
msgstr ""
"The upper limit is {v}. Proton gives its threads file handles of their own, "
"and with too few the game aborts with 'Too many open files'."

#: dynotiq.py:1862
msgid "MangoHud ist nicht installiert"
msgstr "MangoHud is not installed"

#: dynotiq.py:1863
msgid ""
"Blendet Bildrate, Frametimes und Temperaturen ins Spiel ein. Erst damit "
"siehst du, ob eine Änderung wirklich etwas gebracht hat. Startbefehl: "
"'mangohud %command%'."
msgstr ""
"Shows frame rate, frame times and temperatures inside the game. Only then "
"can you tell whether a change actually did anything. Launch command: "
"'mangohud %command%'."

#: dynotiq.py:1866
msgid "MangoHud installieren"
msgstr "Install MangoHud"

#: dynotiq.py:1871
msgid "MangoHud zeigt in OpenGL-Spielen nichts an"
msgstr "MangoHud shows nothing in OpenGL games"

#: dynotiq.py:1872
msgid ""
"Betrifft nur die wenigen Spiele, die mit OpenGL rendern. Dort misst diese "
"Fassung zwar mit, das Overlay bleibt aber unsichtbar, ein bekannter Fehler. "
"Behoben ist er ab 0.8.2, und die hat noch kein Ubuntu: 24.04 liefert "
"0.6.9.1, 25.04 liefert 0.7.2. Wer das braucht, holt sich die Fassung von "
"github.com/flightlessmango/MangoHud. Für alles mit Vulkan, und das ist fast "
"alles, reicht die vorhandene."
msgstr ""
"Only affects the few games that render with OpenGL. This version does "
"measure them, but the overlay stays invisible, a known bug. It is fixed from "
"0.8.2 on, and no Ubuntu ships that yet: 24.04 has 0.6.9.1, 25.04 has 0.7.2. "
"If you need it, get that version from github.com/flightlessmango/MangoHud. "
"For anything on Vulkan, and that is nearly everything, the installed one "
"does the job."

#: dynotiq.py:1924
#, python-brace-format
msgid "Prüfstand: {what}"
msgstr "Dyno: {what}"

#: dynotiq.py:1926
msgid "Noch kein Prüfstandslauf mit diesem Spiel"
msgstr "No dyno run with this game yet"

#: dynotiq.py:1927
msgid ""
"Der Prüfstand zeichnet während des Spielens Temperatur, Takt und Drosselung "
"auf und erkennt das Spiel selbst. Erst danach steht fest, ob Hitze, "
"Wattbudget oder die CPU die Bildrate begrenzt."
msgstr ""
"The dyno records temperature, clock and throttling while you play and "
"recognises the game on its own. Only afterwards is it clear whether heat, "
"power budget or the CPU limits the frame rate."

#: dynotiq.py:1932
msgid "Keine Auffälligkeiten"
msgstr "Nothing unusual"

#: dynotiq.py:1933
msgid "Bibliotheken, Rechte und Journal sind sauber."
msgstr "Libraries, permissions and journal are clean."

#: dynotiq.py:1935
msgid "Installation, Shader und Einstellungen sind in Ordnung."
msgstr "Installation, shaders and settings are in order."

#: dynotiq.py:1945
