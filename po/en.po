#: dynolab.py:5789
#, python-brace-format
msgid "Build {id}"
msgstr "Build {id}"

#: dynolab.py:671 dynolab.py:5788
msgid "neu"
msgstr "new"

#: dynolab.py:709
#, python-brace-format
msgid "{tool} antwortet nicht"
msgstr "{tool} is not responding"

#: dynolab.py:713
#, python-brace-format
msgid "{tool} endete mit Code {rc}"
msgstr "{tool} exited with code {rc}"

#: dynolab.py:738
msgid "fwupdmgr nicht erreichbar"
msgstr "fwupdmgr not reachable"

#: dynolab.py:932
msgid "Paket"
msgstr "Package"

#: dynolab.py:933
msgid "manuell installiert"
msgstr "installed by hand"

#: dynolab.py:938 dynolab.py:5942
msgid "Mikrofon"
msgstr "Microphone"

#: dynolab.py:938
msgid "Die App kann nichts aufnehmen. Nötig für Spracheingabe oder Anrufe."
msgstr "The app cannot record. Needed for voice input or calls."

#: dynolab.py:940
msgid "Tonwiedergabe"
msgstr "Audio playback"

#: dynolab.py:940
msgid "Die App bleibt stumm."
msgstr "The app stays silent."

#: dynolab.py:941
msgid "Kamera"
msgstr "Camera"

#: dynolab.py:941
msgid "Video und Fotos gehen nicht."
msgstr "Video and photos will not work."

#: dynolab.py:942 dynolab.py:5943
msgid "USB-Sticks und externe Laufwerke"
msgstr "USB sticks and external drives"

#: dynolab.py:942
msgid "Die App sieht nur dein Home-Verzeichnis, nichts unter /media."
msgstr "The app only sees your home directory, nothing under /media."

#: dynolab.py:944
msgid "Eigene Dateien"
msgstr "Your files"

#: dynolab.py:944
msgid "Die App kommt nicht an dein Home-Verzeichnis."
msgstr "The app cannot reach your home directory."

#: dynolab.py:945
msgid "Internet"
msgstr "Internet"

#: dynolab.py:945
msgid "Die App kann nicht ins Netz."
msgstr "The app cannot go online."

#: dynolab.py:946
msgid "Netzwerkeinstellungen"
msgstr "Network settings"

#: dynolab.py:946
msgid "Nur nötig, wenn die App Verbindungen selbst einrichten soll."
msgstr "Only needed if the app is meant to set up connections itself."

#: dynolab.py:948
msgid "Drucken"
msgstr "Printing"

#: dynolab.py:948
msgid "Druckaufträge gehen nicht raus."
msgstr "Print jobs will not go out."

#: dynolab.py:949 dynolab.py:950
msgid "Bluetooth"
msgstr "Bluetooth"

#: dynolab.py:949 dynolab.py:950
msgid "Geräte lassen sich nicht koppeln."
msgstr "Devices cannot be paired."

#: dynolab.py:951
msgid "Standort"
msgstr "Location"

#: dynolab.py:951
msgid "Ortsbezogene Funktionen bleiben leer."
msgstr "Location based features stay empty."

#: dynolab.py:952
msgid "Schlüsselbund"
msgstr "Keyring"

#: dynolab.py:952
msgid ""
"Gespeicherte Passwörter sind nicht erreichbar, Anmeldungen fragen jedes Mal "
"neu."
msgstr "Saved passwords are out of reach, every login asks again."

#: dynolab.py:954
msgid "Bildschirmschoner unterdrücken"
msgstr "Inhibit screensaver"

#: dynolab.py:954
msgid "Der Bildschirm schaltet auch während Wiedergabe oder Präsentation ab."
msgstr "The screen also switches off during playback or a presentation."

#: dynolab.py:956
msgid "Systemprozesse ansehen"
msgstr "View system processes"

#: dynolab.py:956
msgid "Nur für Werkzeuge nötig, die andere Programme überwachen."
msgstr "Only needed for tools that monitor other programs."

#: dynolab.py:958
msgid "Prozesse steuern"
msgstr "Control processes"

#: dynolab.py:958 dynolab.py:982
msgid "Nur für Systemwerkzeuge nötig."
msgstr "Only needed for system tools."

#: dynolab.py:959
msgid "Hardware auslesen"
msgstr "Read hardware"

#: dynolab.py:959
msgid "Angaben zu Geräten bleiben leer."
msgstr "Device details stay empty."

#: dynolab.py:960
msgid "Laufwerke sehen"
msgstr "See drives"

#: dynolab.py:961
msgid "Eingehängte Datenträger bleiben unsichtbar."
msgstr "Mounted volumes stay invisible."

#: dynolab.py:962
msgid "USB-Geräte direkt"
msgstr "Direct USB access"

#: dynolab.py:962
msgid "Nötig für Programmiergeräte, Scanner und Ähnliches."
msgstr "Needed for programmers, scanners and the like."

#: dynolab.py:964
msgid "CD- und DVD-Laufwerk"
msgstr "CD and DVD drive"

#: dynolab.py:964
msgid "Discs werden nicht gelesen."
msgstr "Discs will not be read."

#: dynolab.py:965
msgid "Gamecontroller"
msgstr "Game controller"

#: dynolab.py:965
msgid "Controller werden nicht erkannt."
msgstr "Controllers will not be detected."

#: dynolab.py:966
msgid "GPG-Schlüssel"
msgstr "GPG keys"

#: dynolab.py:966
msgid "Signieren und Entschlüsseln geht nicht."
msgstr "Signing and decrypting will not work."

#: dynolab.py:967
msgid "Firmenanmeldung"
msgstr "Enterprise login"

#: dynolab.py:968
msgid "Nur in Firmennetzen mit Kerberos nötig."
msgstr "Only needed on corporate networks with Kerberos."

#: dynolab.py:969
msgid "Geräte im lokalen Netz finden"
msgstr "Find devices on the local network"

#: dynolab.py:969
msgid "Drucker und Freigaben tauchen nicht von selbst auf."
msgstr "Printers and shares will not show up on their own."

#: dynolab.py:971
msgid "Chipkartenleser"
msgstr "Smart card reader"

#: dynolab.py:971
msgid "Signaturkarten werden nicht erkannt."
msgstr "Signature cards will not be detected."

#: dynolab.py:972
msgid "Sicherheitsschlüssel"
msgstr "Security keys"

#: dynolab.py:972
msgid "YubiKey und ähnliche Sticks werden nicht erkannt."
msgstr "YubiKey and similar sticks will not be detected."

#: dynolab.py:974
msgid "Andere Programme starten"
msgstr "Launch other programs"

#: dynolab.py:974
msgid "Links öffnen sich möglicherweise nicht im Browser."
msgstr "Links may not open in the browser."

#: dynolab.py:976
msgid "Bestimmte eigene Dateien"
msgstr "Specific files of yours"

#: dynolab.py:976
msgid "Zugriff auf einzelne Ordner im Home."
msgstr "Access to individual folders in home."

#: dynolab.py:978
msgid "Bestimmte Systemdateien"
msgstr "Specific system files"

#: dynolab.py:979
msgid "Zugriff auf einzelne Systemordner."
msgstr "Access to individual system folders."

#: dynolab.py:980
msgid "Gemeinsamer Speicher"
msgstr "Shared memory"

#: dynolab.py:980
msgid "Nötig für manche Fenster- und Videofunktionen."
msgstr "Needed for some window and video features."

#: dynolab.py:982
msgid "Rechnername ändern"
msgstr "Change hostname"

#: dynolab.py:983
msgid "TV-Karte"
msgstr "TV card"

#: dynolab.py:983
msgid "Fernsehempfang geht nicht."
msgstr "TV reception will not work."

#: dynolab.py:984
msgid "Eingabegeräte direkt"
msgstr "Direct input devices"

#: dynolab.py:984
msgid "Nötig für manche Tastatur- und Controllerfunktionen."
msgstr "Needed for some keyboard and controller features."

#: dynolab.py:995 dynolab.py:5947
msgid "Was genau dahinter steckt, sagt die Beschreibung des Snaps."
msgstr "What exactly this covers is in the snap's own description."

#: dynolab.py:1056
msgid ""
"Läuft abgeschottet in einer Sandbox. Zugriffe auf Mikrofon, Kamera oder "
"externe Laufwerke müssen einzeln freigegeben werden."
msgstr ""
"Runs sealed off in a sandbox. Access to microphone, camera or external "
"drives has to be granted one by one."

#: dynolab.py:1058
msgid ""
"Läuft abgeschottet in einer Sandbox mit eigenen Bibliotheken, unabhängig vom "
"Rest des Systems."
msgstr ""
"Runs sealed off in a sandbox with its own libraries, independent of the rest "
"of the system."

#: dynolab.py:1060
msgid "Über die Paketverwaltung eingetragen, dpkg kennt es."
msgstr "Registered with the package manager, dpkg knows about it."

#: dynolab.py:1061
msgid ""
"Von Hand installiert, ohne Paketquelle. Updates musst du selbst einspielen."
msgstr ""
"Installed by hand, without a package source. You have to apply updates "
"yourself."

#: dynolab.py:1063
msgid ""
"Einzelne Programmdatei, die alles mitbringt. Updates musst du selbst "
"einspielen."
msgstr ""
"A single program file that brings everything with it. You have to apply "
"updates yourself."

#: dynolab.py:1071 dynolab.py:1285
msgid "AppImage nicht gefunden"
msgstr "AppImage not found"

#: dynolab.py:1072
#, python-brace-format
msgid ""
"{path} liegt nicht mehr dort. Der Starter zeigt ins Leere und lässt sich "
"löschen."
msgstr ""
"{path} is no longer there. The launcher points at nothing and can be deleted."

#: dynolab.py:1077
msgid "Nicht ausführbar"
msgstr "Not executable"

#: dynolab.py:1078
msgid "Der Datei fehlt das Ausführungsrecht, ohne das startet sie nicht."
msgstr "The file has no execute permission, without it it will not start."

#: dynolab.py:1080
msgid "Recht setzen"
msgstr "Set permission"

#: dynolab.py:1082
msgid "Datei"
msgstr "File"

#: dynolab.py:1083
#, python-brace-format
msgid "{size}, ausführbar"
msgstr "{size}, executable"

#: dynolab.py:1086
msgid "libfuse2 fehlt"
msgstr "libfuse2 is missing"

#: dynolab.py:1087
msgid ""
"AppImages der ersten Generation brauchen sie zum Entpacken. Ohne sie bricht "
"der Start mit 'dlopen(): error loading libfuse.so.2' ab."
msgstr ""
"First generation AppImages need it to unpack. Without it the start fails "
"with 'dlopen(): error loading libfuse.so.2'."

#: dynolab.py:1090
msgid "libfuse2 installieren"
msgstr "Install libfuse2"

#: dynolab.py:1102
msgid "Paket nicht sauber installiert"
msgstr "Package not cleanly installed"

#: dynolab.py:1103
#, python-brace-format
msgid ""
"dpkg meldet den Status '{status}'. So bleibt ein abgebrochener "
"Installationslauf liegen, das Programm ist unvollständig."
msgstr ""
"dpkg reports status '{status}'. An aborted installation run is left behind "
"like this, the program is incomplete."

#: dynolab.py:1106
msgid "Installation reparieren"
msgstr "Repair installation"

#: dynolab.py:1117
#, python-brace-format
msgid "Version {v} bekommt keine Updates"
msgstr "Version {v} gets no updates"

#: dynolab.py:1118
#, python-brace-format
msgid "Installiert am {date}. "
msgstr "Installed on {date}. "

#: dynolab.py:1120
msgid ""
"Das Paket steht in keiner Paketquelle, es wurde von Hand eingespielt. Die "
"Systemaktualisierung übergeht es, neue Versionen musst du selbst holen."
msgstr ""
"The package is in no package source, it was applied by hand. The system "
"update skips it, you have to fetch new versions yourself."

#: dynolab.py:1125
#, python-brace-format
msgid "Version {v}, verfügbar wäre {avail}"
msgstr "Version {v}, {avail} would be available"

#: dynolab.py:1127
msgid "Die Systemaktualisierung hat das noch nicht eingespielt."
msgstr "The system update has not applied this yet."

#: dynolab.py:1128
msgid "Jetzt aktualisieren"
msgstr "Update now"

#: dynolab.py:1134
#, python-brace-format
msgid "Version {v}"
msgstr "Version {v}"

#: dynolab.py:1135
#, python-brace-format
msgid "Installiert am {date}, "
msgstr "Installed on {date}, "

#: dynolab.py:1137
msgid "aktuell laut Paketquelle."
msgstr "up to date according to the package source."

#: dynolab.py:1141
msgid "Fehlende Bibliotheken"
msgstr "Missing libraries"

#: dynolab.py:1142
msgid "Das Programm startet so nicht: "
msgstr "The program will not start like this: "

#: dynolab.py:1143
msgid "Abhängigkeiten nachziehen"
msgstr "Pull in dependencies"

#: dynolab.py:1145
msgid "Bibliotheken"
msgstr "Libraries"

#: dynolab.py:1145
msgid "alle auflösbar"
msgstr "all resolvable"

#: dynolab.py:1149
msgid "Paket neu installieren"
msgstr "Reinstall package"

#: dynolab.py:1153 dynolab.py:1285
msgid "Programm nicht gefunden"
msgstr "Program not found"

#: dynolab.py:1154
#, python-brace-format
msgid "{path} liegt nicht (mehr) dort."
msgstr "{path} is not (or no longer) there."

#: dynolab.py:1165
#, python-brace-format
msgid "{iface} nicht freigegeben"
msgstr "{iface} not granted"

#: dynolab.py:1166
#, python-brace-format
msgid ""
"{why} Brauchst du das nicht, kannst du es so lassen. Fachbegriff: {name}."
msgstr ""
"{why} If you do not need it, you can leave it as it is. Technical name: "
"{name}."

#: dynolab.py:1168 dynolab.py:1181 dynolab.py:1189
msgid "Freigeben"
msgstr "Grant"

#: dynolab.py:1171
msgid "Freigaben"
msgstr "Permissions"

#: dynolab.py:1171
msgid "Die App hat alles, was sie angefordert hat."
msgstr "The app has everything it asked for."

#: dynolab.py:1178
msgid "Keine Grafikbeschleunigung"
msgstr "No graphics acceleration"

#: dynolab.py:1179
msgid "devices=dri fehlt, das Programm rendert in Software und ruckelt."
msgstr "devices=dri is missing, the program renders in software and stutters."

#: dynolab.py:1184
msgid "Grafikbeschleunigung"
msgstr "Graphics acceleration"

#: dynolab.py:1184
msgid "vorhanden"
msgstr "present"

#: dynolab.py:1186
msgid "Kein Zugriff auf die Anzeige"
msgstr "No access to the display"

#: dynolab.py:1187
msgid "Weder X11 noch Wayland freigegeben, das Fenster kann nicht erscheinen."
msgstr "Neither X11 nor Wayland granted, the window cannot appear."

#: dynolab.py:1193
msgid "Dateizugriff"
msgstr "File access"

#: dynolab.py:1201
msgid "mit einem Systemdienst sprechen"
msgstr "talk to a system service"

#: dynolab.py:1202
msgid "auf Systemmeldungen hören"
msgstr "listen for system messages"

#: dynolab.py:1203
msgid "eine Datei öffnen"
msgstr "open a file"

#: dynolab.py:1203
msgid "eine Datei weiterreichen"
msgstr "pass on a file"

#: dynolab.py:1204
msgid "ein anderes Programm starten"
msgstr "start another program"

#: dynolab.py:1205
msgid "eine Verbindung aufbauen"
msgstr "open a connection"

#: dynolab.py:1206
msgid "eine Systemberechtigung nutzen"
msgstr "use a system capability"

#: dynolab.py:1209
#, python-brace-format
msgid "{n} mal von der Sandbox gebremst"
msgstr "Blocked by the sandbox {n} times"

#: dynolab.py:1210
msgid "Die App wollte "
msgstr "The app tried to "

#: dynolab.py:1210
msgid " und "
msgstr " and "

#: dynolab.py:1211
msgid ""
", durfte aber nicht. Das ist der Normalfall bei Snaps und meist harmlos. Nur "
"wenn etwas in der App wirklich nicht geht, lohnt ein Blick auf die Freigaben "
"darüber."
msgstr ""
", but was not allowed to. That is the normal case with snaps and usually "
"harmless. Only if something in the app really does not work is it worth "
"looking at the permissions above."

#: dynolab.py:1221
#, python-brace-format
msgid "{n} Abstürze aufgezeichnet"
msgstr "{n} crashes recorded"

#: dynolab.py:1222
msgid "Der Bericht zeigt, woran es lag."
msgstr "The report shows what went wrong."

#: dynolab.py:1223
msgid "Bericht ansehen"
msgstr "View report"

#: dynolab.py:1232
#, python-brace-format
msgid "{n} Fehlermeldungen im Journal"
msgstr "{n} error messages in the journal"

#: dynolab.py:1234 dynolab.py:5579
msgid "Alle anzeigen"
msgstr "Show all"

#: dynolab.py:1246
#, python-brace-format
msgid "Belegt {size} im Home"
msgstr "Uses {size} in home"

#: dynolab.py:1247
#, python-brace-format
msgid "Größter Posten: {path} mit {size}."
msgstr "Largest item: {path} with {size}."

#: dynolab.py:1249
#, python-brace-format
msgid " Dazu {n} weitere Ordner."
msgstr " Plus {n} more folders."

#: dynolab.py:1255
#, python-brace-format
msgid "{size} davon nur Zwischenspeicher"
msgstr "{size} of that is only cache"

#: dynolab.py:1257
#, python-brace-format
msgid ""
"In {dirs}. Die Anwendung legt das beim nächsten Start neu an, deine "
"Anmeldung und Einstellungen bleiben."
msgstr ""
"In {dirs}. The application recreates this on the next start, your login and "
"settings stay."

#: dynolab.py:1260
msgid "Zwischenspeicher leeren"
msgstr "Clear cache"

#: dynolab.py:1268
msgid "Startet automatisch mit der Anmeldung"
msgstr "Starts automatically at login"

#: dynolab.py:1269
msgid "Autostart-Eintrag vorhanden, aber abgeschaltet"
msgstr "Startup entry present, but switched off"

#: dynolab.py:1270
#, python-brace-format
msgid "Eintrag {file}. Ändern lässt sich das unter Autostart."
msgstr "Entry {file}. You can change this under Startup."

#: dynolab.py:1277
msgid "Läuft gerade"
msgstr "Currently running"

#: dynolab.py:1278
#, python-brace-format
msgid "{n} Prozess(e), {size} Speicher"
msgstr "{n} process(es), {size} memory"

#: dynolab.py:1288
msgid "Verwaister Starter"
msgstr "Orphaned launcher"

#: dynolab.py:1289
#, python-brace-format
msgid ""
"{path} zeigt auf ein Programm, das es nicht mehr gibt. Der Eintrag im Menü "
"bleibt sonst für immer stehen."
msgstr ""
"{path} points at a program that no longer exists. Otherwise the menu entry "
"stays there forever."

#: dynolab.py:1292
msgid "Starter entfernen"
msgstr "Remove launcher"

#: dynolab.py:1295
msgid "Keine Auffälligkeiten"
msgstr "Nothing unusual"

#: dynolab.py:1296
msgid "Bibliotheken, Rechte und Journal sind sauber."
msgstr "Libraries, permissions and journal are clean."

#: dynolab.py:1302
#, python-brace-format
msgid "App-Check: {app}"
msgstr "App Check: {app}"

#: dynolab.py:1313 dynolab.py:3729
msgid "Systemcheck"
msgstr "System Check"

#: dynolab.py:1313
msgid ""
"Findet, was den Rechner ausbremst: veraltete Treiber, Wärmedrosselung, volle "
"Dateisysteme, ein wucherndes Journal. Jeder Befund erklärt sich und bringt "
"den passenden Befehl mit."
msgstr ""
"Finds what slows the machine down: outdated drivers, thermal throttling, "
"full filesystems, a journal running wild. Every finding explains itself and "
"comes with the matching command."

#: dynolab.py:1316 dynolab.py:2847 dynolab.py:3959
msgid "Vorfälle"
msgstr "Incidents"

#: dynolab.py:1316
msgid ""
"Liest das Journal nach Audio-Aussetzern, GPU-Treiberfehlern und "
"abgeschossenen Prozessen und schreibt dazu, wie warm es zu dem Zeitpunkt war."
msgstr ""
"Reads the journal for audio dropouts, GPU driver errors and killed "
"processes, and notes how warm the machine was at that moment."

#: dynolab.py:1318 dynolab.py:2849 dynolab.py:4166
msgid "Updates"
msgstr "Updates"

#: dynolab.py:1318
msgid ""
"apt, Snap, Flatpak und Firmware an einer Stelle, mit Größenangabe und "
"Protokoll. Auf Wunsch mit Timeshift-Sicherung davor."
msgstr ""
"apt, Snap, Flatpak and firmware in one place, with sizes and a log. "
"Optionally with a Timeshift snapshot beforehand."

#: dynolab.py:1320 dynolab.py:2849 dynolab.py:4623
msgid "App-Check"
msgstr "App Check"

#: dynolab.py:1320
msgid ""
"Nimmt eine installierte Anwendung auseinander: fehlende Bibliotheken, "
"abgeschnittene Sandbox-Rechte, Abstürze. Wo es eine Lösung gibt, steht ein "
"Knopf daneben."
msgstr ""
"Takes an installed application apart: missing libraries, cut off sandbox "
"permissions, crashes. Where there is a fix, a button sits next to it."

#: dynolab.py:1323 dynolab.py:2851 dynolab.py:4507
msgid "Prüfstand"
msgstr "Dyno"

#: dynolab.py:1323
msgid ""
"Zeichnet Temperatur und Takt über Minuten auf und sagt dir, ab wann unter "
"Dauerlast gedrosselt wird."
msgstr ""
"Records temperature and clock over minutes and tells you when sustained load "
"starts throttling."

#: dynolab.py:1328
msgid "Erste Ausgabe"
msgstr "First release"

#: dynolab.py:1329
msgid "Systemcheck mit Punktzahl und erklärten Befunden"
msgstr "System check with a score and explained findings"

#: dynolab.py:1330
msgid "Vorfallserkennung aus dem Journal, auf Wunsch im Hintergrund"
msgstr "Incident detection from the journal, optionally in the background"

#: dynolab.py:1331
msgid "Updates für apt, Snap, Flatpak und Firmware"
msgstr "Updates for apt, Snap, Flatpak and firmware"

#: dynolab.py:1332
msgid "App-Check, Prüfstand, Benchmark mit eigener Basislinie"
msgstr "App Check, Dyno and benchmark with your own baseline"

#: dynolab.py:1380
msgid "CPU-Last"
msgstr "CPU load"

#: dynolab.py:1380 dynolab.py:2170 dynolab.py:4867
msgid "Arbeitsspeicher"
msgstr "Memory"

#: dynolab.py:1381
msgid "CPU-Temperatur"
msgstr "CPU temperature"

#: dynolab.py:1381
msgid "GPU-Last"
msgstr "GPU load"

#: dynolab.py:1382
msgid "GPU-Temperatur"
msgstr "GPU temperature"

#: dynolab.py:1383
msgid "GPU-Takt"
msgstr "GPU clock"

#: dynolab.py:1389 dynolab.py:5905
msgid "Keine Messpunkte aufgezeichnet."
msgstr "No samples recorded."

#: dynolab.py:1391
#, python-brace-format
msgid "Aufzeichnung über {mins}:{secs:02d} min ({n} Messpunkte)"
msgstr "Recording over {mins}:{secs:02d} min ({n} samples)"

#: dynolab.py:1394
msgid "niedrigster"
msgstr "lowest"

#: dynolab.py:1394 dynolab.py:5148
msgid "üblich"
msgstr "typical"

#: dynolab.py:1394
msgid "höchster"
msgstr "highest"

#: dynolab.py:1403 dynolab.py:5908
#, python-format, python-brace-format
msgid ""
"Die Grafikkarte drosselte in {pct} % der Messpunkte, erstmals nach {mins}:"
"{secs:02d} min."
msgstr ""
"The graphics card throttled in {pct} % of the samples, first after {mins}:"
"{secs:02d} min."

#: dynolab.py:1406
msgid "Das ist der Punkt, an dem die Leistung unter Dauerlast einbricht."
msgstr "That is the point where performance breaks down under sustained load."

#: dynolab.py:1408 dynolab.py:5910
msgid "Keine Drosselung aufgezeichnet."
msgstr "No throttling recorded."

#: dynolab.py:1462
#, python-brace-format
msgid "GPU-Treiber veraltet - nvidia-driver-{v}"
msgstr "GPU driver outdated - nvidia-driver-{v}"

#: dynolab.py:1463
#, python-brace-format
msgid "Ubuntu empfiehlt für diese Karte {pkg}."
msgstr "Ubuntu recommends {pkg} for this card."

