msgstr "System journal uses {gb:.1f} GB"

#: dynotiq.py:6948
msgid "Alte Logs lassen sich auf 500 MB eindampfen."
msgstr "Old logs can be trimmed down to 500 MB."

#: dynotiq.py:6949
#, python-brace-format
