#: dynotiq.py:3310
#, python-brace-format
msgid ""
"{n} von {total} Fremdquellen haben noch keine Pakete für {v}. Beim Upgrade "
"würden sie abgeschaltet."
msgstr ""
"{n} of {total} third-party sources have no packages for {v} yet. The upgrade "
