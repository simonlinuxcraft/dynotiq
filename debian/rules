#!/usr/bin/make -f

%:
	dh $@

# Kein Build-System, alles passiert beim Installieren. install-tree.sh ist
# dieselbe Quelle, aus der auch build-deb.sh das lokale Paket baut.
override_dh_auto_build:

override_dh_auto_install:
	./install-tree.sh debian/dynotiq

# Kein Test beim Paketbau. dynotiq.py fordert schon beim Import GTK 4.0 an, das
# muesste sonst als Build-Depends in die Chroot, nur um einen Test zu wiederholen
# der ohnehin schon gelaufen ist. Der Selftest laeuft vor dem Paketieren auf dem
# Entwicklungsrechner, dort mit echten Systemwerkzeugen.
override_dh_auto_test:
